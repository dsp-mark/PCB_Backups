	(text "When TE is low, 10nF discharged; TRIGA will be 0V\n\nWhen TE first turns on, 10nF cap pulls the line up\n\nThe 10kohm resister pulls the line back down\n\nThis downward dip will pull TRIGA below 1/3 GSE; it will activate"
		(exclude_from_sim no)
		(at 52.578 85.344 0)
		(effects
			(font
				(size 1.27 1.27)
			)
		)
		(uuid "348d51ad-3c6f-4795-8f3a-34dab2a88ac8")
	)
	(text "When TE is high, 10nF capacitor is charged; line at 3.3V\n\nWhen TE starts to fall, capacitor briefly drags TRIG below 1/3 GSE\n\nThe 10kohm shapes the curve; the second 100kohm ensures TRIG defaults to up"
		(exclude_from_sim no)
		(at 57.658 138.938 0)
		(effects
			(font
				(size 1.27 1.27)
			)
		)
		(uuid "4ed687f6-0a7e-444f-8038-46d5bbb6a3b6")
	)
	(text "Triggers when TE turns on"
		(exclude_from_sim no)
		(at 128.778 61.468 0)
		(effects
			(font
				(size 1.27 1.27)
			)
		)
		(uuid "75d1e8d2-88ee-4c6b-bae6-c5836055a37f")
	)
